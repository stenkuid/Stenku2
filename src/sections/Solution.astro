---
import SectionHeading from '../components/SectionHeading.astro';
import { content } from '../utils/content';

const lang = 'en';
const t = content[lang].solution;
---

<section class="solution-section section-padding">
  <div class="container">
    <SectionHeading 
      tag={t.tag}
      title={t.title}
      description={t.description}
    />
    
    <div class="steps-container">
      {t.steps.map((step, index) => (
        <div class="step-card">
          <!-- Connector line visual -->
          {index < t.steps.length - 1 && <div class="step-line-connector"></div>}
          
          <div class="step-number-badge">{step.number}</div>
          <div class="step-content">
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .solution-section {
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    position: relative;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .steps-container {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
    margin-top: 4rem;
    position: relative;
  }

  @media (max-width: 1024px) {
    .steps-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .step-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  @media (max-width: 1024px) {
    .step-card {
      flex-direction: row;
      gap: 1.5rem;
    }
  }

  /* Connector line styles between cards */
  .step-line-connector {
    position: absolute;
    top: 1.25rem;
    left: 2.5rem;
    right: -2.5rem;
    height: 1px;
    background-color: var(--border-strong);
    z-index: 1;
    opacity: 0.5;
  }

  @media (max-width: 1024px) {
    .step-line-connector {
      left: 1.25rem;
      top: 2.5rem;
      bottom: -2.5rem;
      width: 1px;
      height: auto;
      right: auto;
    }
  }

  .step-number-badge {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background-color: var(--bg-primary);
    color: var(--text-primary);
    border: 1px solid var(--border-strong);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .step-card:hover .step-number-badge {
    border-color: var(--accent);
    background-color: var(--accent-light);
    color: var(--accent);
  }

  .step-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .step-title {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .step-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>

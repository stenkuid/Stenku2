---
import { content, config } from '../utils/content';

const lang = 'en';
const t = content[lang].cta;
---

<section id="cta" class="cta-section section-padding">
  <div class="container cta-container">
    <div class="cta-box">
      <h2 class="cta-title">{t.title}</h2>
      <p class="cta-desc">{t.subtitle}</p>
      
      <!-- Premium CSS Form -->
      <form class="cta-form" id="cta-form">
        <div class="form-grid">
          <div class="form-group">
            <label for="inquiry-name" class="form-label">Full Name <span class="req">*</span></label>
            <input type="text" id="inquiry-name" name="name" required class="form-input" placeholder="e.g. John Doe" />
          </div>
          <div class="form-group">
            <label for="inquiry-email" class="form-label">Email Address <span class="req">*</span></label>
            <input type="email" id="inquiry-email" name="email" required class="form-input" placeholder="e.g. name@company.com" />
          </div>
        </div>
        
        <div class="form-group">
          <label for="inquiry-company" class="form-label">Company Name</label>
          <input type="text" id="inquiry-company" name="company" class="form-input" placeholder="e.g. Acme Corp" />
        </div>
        
        <div class="form-group">
          <label for="inquiry-message" class="form-label">Tell us about your workflow <span class="req">*</span></label>
          <textarea id="inquiry-message" name="message" required class="form-input form-textarea" rows="4" placeholder="How do your operations work? What WhatsApp messages or manual tasks do you want to automate?"></textarea>
        </div>
        
        <div class="form-actions">
          <button type="submit" id="submit-btn" class="form-submit-btn">
            {t.button}
          </button>
          <a href={`mailto:${config.contactEmail}?subject=Build%20Custom%20AI%20Agent`} class="direct-email-link">
            Or email us directly
          </a>
        </div>
        
        <div id="form-feedback" class="form-feedback-message"></div>
      </form>
      
      <span class="cta-footnote">{t.footnote}</span>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .cta-container {
    max-width: 900px;
  }

  .cta-box {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--border-radius);
    padding: 4rem 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    position: relative;
    overflow: hidden;
    transition: border-color var(--transition-normal);
  }

  @media (max-width: 768px) {
    .cta-box {
      padding: 3rem 1.5rem;
    }
  }

  /* Sleek accent lighting line at the top of the CTA card */
  .cta-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: var(--accent);
  }

  .cta-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-align: center;
  }

  @media (max-width: 768px) {
    .cta-title {
      font-size: 2rem;
    }
  }

  .cta-desc {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 600px;
    text-align: center;
    margin-bottom: 1rem;
  }

  /* Form Elements Styling */
  .cta-form {
    width: 100%;
    max-width: 650px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    text-align: left;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 600px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }

  .req {
    color: #EF4444;
  }

  .form-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: var(--border-radius);
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--focus-ring);
  }

  .form-textarea {
    resize: vertical;
    min-height: 100px;
  }

  .form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .form-submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 2rem;
    border-radius: var(--border-radius);
    background-color: var(--accent);
    color: var(--accent-foreground);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
    cursor: pointer;
    border: none;
  }

  .form-submit-btn:hover {
    background-color: var(--accent-hover);
  }

  .form-submit-btn:active {
    transform: scale(0.98);
  }

  .form-submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .direct-email-link {
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: underline;
    transition: color var(--transition-fast);
  }

  .direct-email-link:hover {
    color: var(--text-primary);
  }

  /* Feedback messages */
  .form-feedback-message {
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.75rem 1rem;
    border-radius: var(--border-radius);
    display: none;
  }

  .form-feedback-message.success {
    display: block;
    background-color: var(--color-success-bg);
    color: var(--color-success);
    border: 1px solid var(--color-success-border);
  }

  .form-feedback-message.error {
    display: block;
    background-color: var(--color-error-bg);
    color: var(--color-error);
    border: 1px solid var(--color-error-border);
  }

  .cta-footnote {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
</style>

<script>
  const setupFormSubmission = () => {
    const form = document.getElementById('cta-form') as HTMLFormElement | null;
    const feedback = document.getElementById('form-feedback');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

    if (!form || !feedback || !submitBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Reset feedback UI
      feedback.className = 'form-feedback-message';
      feedback.style.display = 'none';
      feedback.innerText = '';
      submitBtn.disabled = true;
      submitBtn.innerText = 'Sending...';

      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        email: formData.get('email'),
        company: formData.get('company'),
        message: formData.get('message'),
      };

      try {
        const response = await fetch('/api/submit-inquiry', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          feedback.classList.add('success');
          feedback.innerText = result.message;
          form.reset();
        } else {
          feedback.classList.add('error');
          feedback.innerText = result.error || 'Something went wrong. Please try again.';
        }
      } catch (err) {
        feedback.classList.add('error');
        feedback.innerText = 'Network error. Please check your connection and try again.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerText = 'Send Message';
      }
    });
  };

  // Run on load and swap
  setupFormSubmission();
  document.addEventListener('astro:after-swap', setupFormSubmission);
</script>

---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

// 1. Session verification
const sessionCookie = Astro.cookies.get('admin_session')?.value;
if (sessionCookie !== 'authenticated') {
  return Astro.redirect('/admin/login');
}

// 2. Handle Logout POST request
if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const action = data.get('action')?.toString();
  
  if (action === 'logout') {
    Astro.cookies.delete('admin_session', { path: '/' });
    return Astro.redirect('/admin/login');
  }
}

// 3. Database Query to fetch inquiries from D1
let inquiries: any[] = [];
let dbError = '';

try {
  const db = (Astro.locals as any).runtime?.env?.DB;
  if (!db) {
    dbError = 'Database D1 binding "DB" was not found in environment.';
  } else {
    const result = await db.prepare(
      'SELECT id, name, email, company, message, created_at FROM inquiries ORDER BY created_at DESC'
    ).all();
    inquiries = result.results || [];
  }
} catch (e: any) {
  console.error('Error fetching inquiries from D1:', e);
  dbError = `Failed to query database: ${e.message || e}`;
}
---

<Layout title="Admin Dashboard | Stenku" description="Stenku Admin Inquiry Dashboard.">
  <div class="dashboard-wrapper">
    <!-- Header Navigation -->
    <header class="db-header">
      <div class="db-header-container">
        <div class="brand-group">
          <a href="/" class="logo">STENKU</a>
          <span class="db-badge">Admin Dashboard</span>
        </div>
        
        <!-- Logout Form -->
        <form method="POST" class="logout-form">
          <input type="hidden" name="action" value="logout" />
          <button type="submit" class="logout-btn">Log Out</button>
        </form>
      </div>
    </header>

    <main class="db-main-content">
      <div class="db-container">
        <div class="db-summary-row">
          <h1 class="db-title">Form Inquiries</h1>
          <span class="count-badge">{inquiries.length} submissions</span>
        </div>

        {dbError && (
          <div class="error-banner">
            <strong>Database Error:</strong> {dbError}
          </div>
        )}

        <!-- Data table of submissions -->
        {!dbError && inquiries.length === 0 ? (
          <div class="empty-state">
            <div class="empty-icon">📨</div>
            <h3>No inquiries yet</h3>
            <p>Form submissions from the landing page will appear here.</p>
          </div>
        ) : (
          <div class="table-card">
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Submit Date</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Company</th>
                    <th>Message</th>
                  </tr>
                </thead>
                <tbody>
                  {inquiries.map((inquiry) => (
                    <tr>
                      <td class="td-date">
                        {new Date(inquiry.created_at + 'Z').toLocaleString('en-US', {
                          month: 'short',
                          day: 'numeric',
                          hour: '2-digit',
                          minute: '2-digit'
                        })}
                      </td>
                      <td class="td-name">{inquiry.name}</td>
                      <td class="td-email">
                        <a href={`mailto:${inquiry.email}`} class="mail-link">{inquiry.email}</a>
                      </td>
                      <td class="td-company">{inquiry.company || <span class="muted">-</span>}</td>
                      <td class="td-message">{inquiry.message}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </div>
    </main>
  </div>
</Layout>

<style>
  .dashboard-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--bg-primary);
    color: var(--text-secondary);
  }

  /* Header Styles */
  .db-header {
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border-subtle);
    height: 70px;
    display: flex;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .db-header-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--text-primary);
    text-decoration: none;
  }

  .db-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--accent-light);
    color: var(--accent);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }

  .logout-btn {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: var(--border-radius);
    border: 1px solid var(--border-strong);
    color: var(--text-primary);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .logout-btn:hover {
    background-color: var(--surface);
  }

  /* Main Body Layout */
  .db-main-content {
    flex-grow: 1;
    padding: 3rem 0;
  }

  .db-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .db-summary-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .db-title {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .count-badge {
    font-size: 0.75rem;
    font-weight: 600;
    background-color: var(--surface);
    color: var(--text-secondary);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid var(--border-subtle);
  }

  .error-banner {
    background-color: rgba(239, 68, 68, 0.1);
    color: #EF4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
    padding: 1rem;
    border-radius: var(--border-radius);
    font-size: 0.9rem;
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    background-color: var(--bg-secondary);
    border: 1px dashed var(--border-strong);
    border-radius: var(--border-radius);
    padding: 5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .empty-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  .empty-state h3 {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .empty-state p {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* Table styles */
  .table-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .table-responsive {
    overflow-x: auto;
    width: 100%;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.875rem;
  }

  .data-table th,
  .data-table td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .data-table th {
    background-color: var(--bg-primary);
    font-family: var(--font-sans);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }

  .data-table tbody tr:last-child td {
    border-bottom: none;
  }

  .data-table tbody tr:hover td {
    background-color: var(--bg-primary);
  }

  .td-date {
    white-space: nowrap;
    color: var(--text-muted);
    font-family: monospace;
    font-size: 0.8rem;
  }

  .td-name {
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .td-email {
    white-space: nowrap;
  }

  .mail-link {
    color: var(--accent);
    text-decoration: underline;
  }

  .mail-link:hover {
    color: var(--accent-hover);
  }

  .td-company {
    white-space: nowrap;
    font-weight: 500;
  }

  .td-message {
    min-width: 300px;
    line-height: 1.5;
    white-space: pre-wrap;
  }

  .muted {
    color: var(--text-muted);
  }
</style>

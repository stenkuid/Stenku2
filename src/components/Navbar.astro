---
import ThemeToggle from './ThemeToggle.astro';
import Button from './Button.astro';
import { content } from '../utils/content';

// Determine language (defaults to 'en')
const lang = 'en';
const t = content[lang].navbar;
---

<header class="navbar">
  <div class="container navbar-container">
    <a href="#" class="logo">
      <span class="logo-text">STENKU</span>
    </a>
    
    <!-- Desktop Navigation Links -->
    <nav class="nav-links-desktop" aria-label="Main Navigation">
      <a href="#solutions" class="nav-link">{t.solutions}</a>
      <a href="#use-cases" class="nav-link">{t.useCases}</a>
      <a href="#how-it-works" class="nav-link">{t.howItWorks}</a>
    </nav>
    
    <!-- Action Controls (Theme, CTA, Burger Toggle) -->
    <div class="navbar-actions">
      <div class="theme-wrapper">
        <ThemeToggle />
      </div>
      <div class="cta-wrapper-desktop">
        <Button href="#cta" variant="secondary">{t.cta}</Button>
      </div>
      
      <!-- Mobile Menu Toggle Button -->
      <button class="mobile-nav-toggle" id="mobile-nav-toggle" aria-label="Toggle Menu" aria-expanded="false" aria-controls="mobile-nav-menu">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-open">
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-close">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-nav-menu" id="mobile-nav-menu" aria-hidden="true">
    <div class="container mobile-nav-container">
      <nav class="nav-links-mobile" aria-label="Mobile Navigation">
        <a href="#solutions" class="mobile-nav-link">{t.solutions}</a>
        <a href="#use-cases" class="mobile-nav-link">{t.useCases}</a>
        <a href="#how-it-works" class="mobile-nav-link">{t.howItWorks}</a>
        <div class="mobile-cta-wrapper">
          <Button href="#cta" variant="primary" style="width: 100%;">{t.cta}</Button>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    background-color: rgba(250, 250, 252, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
    z-index: 100;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  :global([data-theme="dark"]) .navbar {
    background-color: rgba(5, 7, 15, 0.8);
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--text-primary);
  }

  /* Desktop Menu Styles */
  .nav-links-desktop {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .cta-wrapper-desktop {
    display: block;
  }

  /* Mobile hamburger styles */
  .mobile-nav-toggle {
    position: relative;
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--border-radius);
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    transition: background-color var(--transition-fast);
  }

  /* Expand interactive touch target on mobile viewports for accessibility */
  @media (max-width: 768px) {
    .mobile-nav-toggle::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 44px;
      height: 44px;
      transform: translate(-50%, -50%);
      min-width: 44px;
      min-height: 44px;
    }
  }

  .mobile-nav-toggle:hover {
    background-color: var(--surface);
  }

  .mobile-nav-toggle svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .menu-icon-close {
    display: none;
  }

  /* Mobile Drawer styles */
  .mobile-nav-menu {
    position: fixed;
    top: var(--header-height);
    left: 0;
    width: 100%;
    height: calc(100vh - var(--header-height));
    background-color: var(--bg-primary);
    border-top: 1px solid var(--border-subtle);
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
    transition: transform var(--transition-normal), opacity var(--transition-normal);
    z-index: 99;
    overflow-y: auto;
  }

  .mobile-nav-menu[aria-hidden="false"] {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav-container {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .nav-links-mobile {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-nav-link {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .mobile-cta-wrapper {
    margin-top: 1.5rem;
  }

  /* Responsive Rules */
  @media (max-width: 768px) {
    .nav-links-desktop,
    .cta-wrapper-desktop {
      display: none;
    }

    .mobile-nav-toggle {
      display: inline-flex;
    }
  }

  /* Hamburger Active state swaps close/open icons */
  header.mobile-menu-active .menu-icon-open {
    display: none;
  }

  header.mobile-menu-active .menu-icon-close {
    display: block;
  }
</style>

<script>
  // Simple Vanilla JS to handle mobile menu drawer
  const setupMobileNavbar = () => {
    const navbar = document.querySelector('.navbar');
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const mobileMenu = document.getElementById('mobile-nav-menu');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    if (!toggleBtn || !mobileMenu || !navbar) return;

    const closeMenu = () => {
      toggleBtn.setAttribute('aria-expanded', 'false');
      mobileMenu.setAttribute('aria-hidden', 'true');
      navbar.classList.remove('mobile-menu-active');
      document.body.style.overflow = '';
    };

    const toggleOpen = () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.setAttribute('aria-hidden', String(isExpanded));
      navbar.classList.toggle('mobile-menu-active');
      
      // Prevent body scrolling when open
      document.body.style.overflow = isExpanded ? '' : 'hidden';
    };

    // Bind event listeners
    toggleBtn.addEventListener('click', toggleOpen);

    // Close menu when clicking link
    mobileLinks.forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Close mobile menu on Escape key press (A11y best practice)
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });
  };

  setupMobileNavbar();
  document.addEventListener('astro:after-swap', setupMobileNavbar);
</script>
